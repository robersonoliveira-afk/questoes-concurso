# Copie para .env e preencha com os dados do seu projeto Supabase.
# Aviso conhecido (mesmo do AgroCusto): o pgBouncer do Supabase (porta 6543)
# às vezes rejeita conexão com ENOTFOUND neste tipo de projeto. Se
# "npm run db:push" falhar assim, use o host direto (porta 5432) nas DUAS
# variáveis abaixo, como já está aqui.

DATABASE_URL="postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"

NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
