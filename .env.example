# Copie para .env e preencha com os dados do seu projeto Supabase.
#
# Formato que funciona de verdade (ver CLAUDE.md § Banco de dados para o
# porquê): pooler, não o host direto — e sslmode=require é obrigatório, sem
# ele a conexão trava e dá o mesmo erro genérico de host/porta errados.
#
#   usuário  = postgres.<ref-do-projeto>   (não "postgres" sozinho)
#   host     = aws-0-<região>.pooler.supabase.com
#   região e ref: Project Settings → General (confirme, o Supabase às vezes
#   não usa a região que você pediu ao criar)
#
# DATABASE_URL = porta 6543 (modo transação), pra runtime/serverless.
# DIRECT_URL   = porta 5432 (modo sessão), pro Prisma Migrate/db push.
# Numa rede que bloqueia 6543 (aconteceu na rede da UFSM), use 5432 nas duas.

DATABASE_URL="postgresql://postgres.SEU-REF:SENHA@aws-0-SUA-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.SEU-REF:SENHA@aws-0-SUA-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require"

NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
